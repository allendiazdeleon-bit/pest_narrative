# Copy to scripts/.env (gitignored) and fill in.
# Used by scripts/agent_curl.sh to drive the Massey Upsell Coach Agentforce agent.

# Org's my-domain host. No scheme, no trailing slash.
export MY_DOMAIN=ne1752196800872.my.salesforce.com

# OAuth Client Credentials from the Connected App you create in Setup.
# Scopes required: api, refresh_token offline_access, chatbot_api, sfap_api
export CONSUMER_KEY=
export CONSUMER_SECRET=

# 18-char Id of the Massey_Upsell_Coach agent.
# After building the agent in Agentforce Builder, grab its Id from the URL
# (last 18 chars after /lightning/setup/EinsteinCopilot/page?...&copilotId=)
# or run:
#   sf data query --query "SELECT Id FROM BotDefinition WHERE DeveloperName='Massey_Upsell_Coach'" --target-org <alias>
export AGENT_ID=
