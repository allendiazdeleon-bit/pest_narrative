<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <backgroundEndColor>#FFFFFF</backgroundEndColor>
    <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <dashboardType>SpecifiedUser</dashboardType>
    <leftSection>
        <columnSize>Medium</columnSize>
        <components>
            <componentType>Bar</componentType>
            <chartAxisRange>Auto</chartAxisRange>
            <sortBy>RowValueDescending</sortBy>
            <displayUnits>Auto</displayUnits>
            <drillEnabled>true</drillEnabled>
            <drillToDetailEnabled>true</drillToDetailEnabled>
            <enableHover>true</enableHover>
            <expandOthers>true</expandOthers>
            <footer>Pair with Coaching Opportunities (right) to compute attach rate. Numerator = leads from Tech Route Pitch MTD; denominator = completed visits MTD per tech.</footer>
            <header>Attach Rate by Tech (MTD)</header>
            <legendPosition>Right</legendPosition>
            <report>Massey_Branch_Coaching/Attach_Rate_by_Tech_MTD</report>
            <showValues>true</showValues>
            <useReportChart>false</useReportChart>
        </components>
        <components>
            <componentType>Table</componentType>
            <indicatorBreakpoint1>50.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>75.0</indicatorBreakpoint2>
            <indicatorHighColor>#54C254</indicatorHighColor>
            <indicatorLowColor>#C25454</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <displayUnits>Auto</displayUnits>
            <drillEnabled>true</drillEnabled>
            <drillToDetailEnabled>true</drillToDetailEnabled>
            <enableHover>true</enableHover>
            <footer>Year-to-date leaderboard. Converted Opportunity Amount approximates revenue impact.</footer>
            <header>Top Performers (YTD)</header>
            <report>Massey_Branch_Coaching/Top_Performers_YTD</report>
            <useReportChart>false</useReportChart>
        </components>
    </leftSection>
    <rightSection>
        <columnSize>Medium</columnSize>
        <components>
            <componentType>Table</componentType>
            <indicatorBreakpoint1>50.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>75.0</indicatorBreakpoint2>
            <indicatorHighColor>#54C254</indicatorHighColor>
            <indicatorLowColor>#C25454</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <displayUnits>Auto</displayUnits>
            <drillEnabled>true</drillEnabled>
            <drillToDetailEnabled>true</drillToDetailEnabled>
            <enableHover>true</enableHover>
            <footer>Completed visits MTD by tech. High volume here + low lead count on the left = coaching candidate.</footer>
            <header>Coaching Opportunities</header>
            <report>Massey_Branch_Coaching/Coaching_Opportunities</report>
            <useReportChart>false</useReportChart>
        </components>
        <components>
            <componentType>Funnel</componentType>
            <chartAxisRange>Auto</chartAxisRange>
            <sortBy>RowValueDescending</sortBy>
            <displayUnits>Auto</displayUnits>
            <drillEnabled>true</drillEnabled>
            <drillToDetailEnabled>true</drillToDetailEnabled>
            <enableHover>true</enableHover>
            <expandOthers>true</expandOthers>
            <footer>Created → Worked → Converted. Closes the revenue loop on tech-originated pitches.</footer>
            <header>Leads from Route to Conversion</header>
            <legendPosition>Right</legendPosition>
            <report>Massey_Branch_Coaching/Leads_from_Route_to_Conversion</report>
            <showValues>true</showValues>
            <useReportChart>false</useReportChart>
        </components>
    </rightSection>
    <runningUser>allen.diazdeleon@neuraflash.com</runningUser>
    <textColor>#000000</textColor>
    <title>Massey — Branch Coaching</title>
    <titleColor>#000000</titleColor>
    <titleSize>12</titleSize>
</Dashboard>
