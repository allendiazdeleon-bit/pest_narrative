<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <chart>
        <chartSummaries>
            <axisBinding>y</axisBinding>
            <column>RowCount</column>
        </chartSummaries>
        <backgroundColor1>#FFFFFF</backgroundColor1>
        <backgroundColor2>#FFFFFF</backgroundColor2>
        <backgroundFadeDir>Diagonal</backgroundFadeDir>
        <chartType>Funnel</chartType>
        <enableHoverLabels>true</enableHoverLabels>
        <groupingColumn>LEAD.STATUS</groupingColumn>
        <legendPosition>Right</legendPosition>
        <location>CHART_BOTTOM</location>
        <showPercentage>true</showPercentage>
        <showTotal>true</showTotal>
        <showValues>true</showValues>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <textColor>#000000</textColor>
        <textSize>12</textSize>
        <title>Tech-Route Leads — Created → Worked → Converted</title>
        <titleColor>#000000</titleColor>
        <titleSize>18</titleSize>
    </chart>
    <columns>
        <field>LEAD.NAME</field>
    </columns>
    <columns>
        <field>LEAD.COMPANY</field>
    </columns>
    <columns>
        <field>OWNER</field>
    </columns>
    <columns>
        <field>CONVERTED</field>
    </columns>
    <columns>
        <field>CONVERTED_OPPORTUNITY_NAME</field>
    </columns>
    <columns>
        <field>CONVERTED_OPPORTUNITY_AMOUNT</field>
    </columns>
    <columns>
        <field>CREATED_DATE</field>
    </columns>
    <description>Funnel of upsell-pitch leads grouped by Lead Status: Open - Not Contacted (created) → Working / Nurturing (worked past initial state) → Closed - Converted (converted to Opportunity). Converted Opportunity Amount surfaces revenue tied to route pitches.</description>
    <filter>
        <criteriaItems>
            <column>LEAD.SOURCE</column>
            <operator>equals</operator>
            <value>Tech Route Pitch</value>
        </criteriaItems>
        <criteriaItems>
            <column>CREATED_DATE</column>
            <operator>equals</operator>
            <value>THIS_YEAR</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>LEAD.STATUS</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Leads from Route to Conversion</name>
    <reportType>LeadList</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
</Report>
